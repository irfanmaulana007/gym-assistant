{
  "name": "gym-assistant",
  "private": true,
  "version": "0.1.0",
  "description": "Gym Assistant monorepo — workspace root. JS/TS deps hoist here so the shared tests/ tree can resolve them (per .claude/rules/testing.md).",
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "test:web": "npm --workspace apps/web run test",
    "test:web:e2e": "npm --workspace apps/web run test:e2e",
    "test:mobile": "npm --workspace apps/mobile run test",
    "test:mobile:native": "npm --workspace apps/mobile run test:native",
    "test:mobile:e2e": "npm --workspace apps/mobile run test:e2e"
  }
}
