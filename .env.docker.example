# Gym Assistant — Docker Compose / Dokploy environment.
# Copy to `.env` for local `docker compose up`, or paste these into Dokploy's
# Environment settings. NEVER commit a real .env.

# ---- Postgres ----
POSTGRES_USER=gym
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=gym_assistant

# ---- API ----
APP_ENV=production
# Secret signing JWT access tokens. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=60
# Refresh-token lifetime in days (PRD 0010) — the max inactivity window before a
# user must log in again. Active users are refreshed silently and never bounced.
REFRESH_TOKEN_TTL_DAYS=30
# Browser origins allowed by CORS — set to your deployed web origin(s),
# comma-separated. Locally this is the web container's published port.
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Host port the API is published on (local compose only).
API_PORT=8080

# ---- Web ----
# Baked into the frontend bundle at build time. MUST be the API origin the
# BROWSER can reach (your public API domain in prod), not an internal hostname.
VITE_API_BASE_URL=http://localhost:8080
# Host port the web app is published on (local compose only).
WEB_PORT=8081

# ---- Remote MCP (PRD 0023) ----
# Public https origin of the MCP service (no path). Add
# "<MCP_PUBLIC_URL>/mcp" as a custom connector in Claude.
MCP_PUBLIC_URL=http://localhost:8082
# Keys every OAuth client id/token the MCP server issues. REQUIRED — the server
# refuses to start if it is empty, shorter than 32 chars, or a "change-me"
# placeholder. Generate with: openssl rand -hex 32 (rotating it disconnects
# every connector).
MCP_OAUTH_SECRET=
# API the MCP server calls (https unless localhost).
GYM_API_BASE_URL=https://api-gym.irfanmaulana007.com
# Host port the MCP service is published on (local compose only).
MCP_PORT=8082
# Trusted proxy hops in front of the MCP service. Keep 0 unless a trusted proxy
# (e.g. Traefik) terminates in front of it; a wrong value lets clients spoof
# X-Forwarded-For and bypass the login rate limit.
MCP_TRUST_PROXY=0
# Optional hardening: comma-separated exact redirect URIs a client may register
# (DCR). Leave empty to accept any (the consent page then shows the destination
# host). Example: https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
MCP_ALLOWED_REDIRECT_URIS=
