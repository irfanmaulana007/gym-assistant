{
  "name": "gym-assistant-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Gym Assistant — native iOS app (bare React Native + TypeScript). Offline-first client with web-UI parity (PRD 0018).",
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "pods": "cd ios && bundle exec pod install",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native": "jest --config jest.config.js",
    "test:e2e": "detox test --configuration ios.sim.debug",
    "build:e2e": "detox build --configuration ios.sim.debug"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^11.0.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@tanstack/react-query": "^5.51.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-config": "^1.5.3",
    "react-native-get-random-values": "^1.11.0",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-keychain": "^9.2.2",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "^4.5.0",
    "react-native-svg": "^15.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@testing-library/react-native": "^12.9.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-test-renderer": "^18.3.0",
    "babel-jest": "^29.7.0",
    "detox": "^20.28.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
