# react-native-config values (copied to `.env`, injected natively at build time).
# No hardcoded URL in code — per apps/api/CLAUDE.md / apps/web/CLAUDE.md. The web
# equivalent is VITE_API_BASE_URL.

# Base URL of the gym-assistant API (`/api/v1` is appended per request).
API_BASE_URL=http://localhost:8080

# anatome muscle-diagram image service (PRD 0009 / 0011).
ANATOME_BASE_URL=https://api.anatome.dev
