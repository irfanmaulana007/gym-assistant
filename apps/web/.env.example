# Gym Assistant web — environment configuration.
# Copy to .env.local and adjust. Never hardcode the API URL in source.

# Base URL of the Gym Assistant API.
VITE_API_BASE_URL=http://localhost:8080

# Base URL of the anatome muscle-diagram service (PRD 0009). The hosted API is
# keyless but rate-limited (50 req/caller/day) — self-host the Apache-2.0 Worker
# on Cloudflare before production traffic. Like VITE_API_BASE_URL this is baked in
# at BUILD time (Vite), so on Dokploy set it as a build-time Argument, not a
# runtime env var.
VITE_ANATOME_BASE_URL=https://api.anatome.dev

# Sentry DSN for error/performance monitoring. Leave empty to disable Sentry
# entirely (the app still renders) — this is the default for local dev and CI so
# they never report to the production Sentry projects. Set the REAL DSN in the
# deploy environment (on Dokploy, as a build-time Argument — it is baked into the
# bundle by Vite at BUILD time, not a runtime env var), not here. A Sentry DSN is
# a public, non-secret identifier; format: https://<key>@<org>.ingest.sentry.io/<project>.
VITE_SENTRY_DSN=
# Environment label reported to Sentry. Defaults to Vite's MODE.
# VITE_SENTRY_ENVIRONMENT=production
