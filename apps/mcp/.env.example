# Gym Assistant MCP server configuration.
# Copy to .env (git-ignored) or set these in your MCP client's "env" block.

# API base URL. Defaults to production if omitted.
GYM_API_BASE_URL=https://api-gym.irfanmaulana007.com

# --- Authentication (pick ONE of the three) ---

# 1. Username/email + password login (recommended for a personal setup).
GYM_API_IDENTIFIER=you@example.com
GYM_API_PASSWORD=your-password

# 2. Or a pre-obtained refresh token (auto-rotated).
# GYM_API_REFRESH_TOKEN=...

# 3. Or a short-lived access token (used as-is, no refresh).
# GYM_API_TOKEN=...
