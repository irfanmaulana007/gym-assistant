# Gym Assistant MCP server configuration.
# Copy to .env (git-ignored) or set these in your MCP client's "env" block.

# API base URL. Defaults to production if omitted. Must be https for any
# non-local host (http is allowed only for localhost/127.0.0.1/::1).
GYM_API_BASE_URL=https://api-gym.irfanmaulana007.com

# Per-request timeout in milliseconds (default 15000).
# GYM_API_TIMEOUT_MS=15000

# Sentry DSN for error/performance monitoring (applies to both stdio and HTTP
# modes). Leave empty to disable Sentry entirely (the server still runs) — this
# is the default for local dev and CI so they never report to the production
# Sentry projects. Set the REAL DSN in the deploy environment (Dokploy), not
# here. A Sentry DSN is a public, non-secret identifier; format:
# https://<key>@<org>.ingest.sentry.io/<project>.
SENTRY_DSN=
# Environment label reported to Sentry. Defaults to NODE_ENV, else "development".
# SENTRY_ENVIRONMENT=production

# --- Authentication (pick ONE of the two) ---

# 1. Username/email + password login (recommended for a personal setup).
#    The server rotates tokens internally for its lifetime.
GYM_API_IDENTIFIER=you@example.com
GYM_API_PASSWORD=your-password

# 2. Or a pre-obtained short-lived access token (used as-is, no auto-renew).
# GYM_API_TOKEN=...

# --- Remote mode only (npm run start:http, PRD 0023) ---
# Credentials above are NOT used in remote mode — each user signs in via OAuth.
# MCP_PUBLIC_URL=https://mcp-gym.irfanmaulana007.com
# MCP_OAUTH_SECRET=   # openssl rand -hex 32
# PORT=3000
# MCP_TRUST_PROXY=1

# NOTE: a raw refresh token is intentionally NOT accepted as a startup
# credential — the API single-uses/rotates refresh tokens, so replaying one on
# each launch would trigger reuse-detection and log you out everywhere.
