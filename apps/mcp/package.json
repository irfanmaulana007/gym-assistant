{
  "name": "gym-assistant-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only MCP server exposing a user's Gym Assistant profile and workout history to MCP clients (Claude Code).",
  "bin": {
    "gym-assistant-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx src/index.ts",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start:http": "node --import ./dist/instrument.js dist/http-main.js",
    "dev:http": "tsx src/http-main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.1",
    "@sentry/node": "^11.11.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
