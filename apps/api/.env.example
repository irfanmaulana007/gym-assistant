# Gym Assistant API — environment configuration.
# Copy to .env and fill in real values. NEVER commit a real .env.

# Deployment environment: development | test | production
APP_ENV=development

# HTTP port the API listens on.
PORT=8080

# PostgreSQL connection string (pgx / libpq format).
DATABASE_URL=postgres://gym:gym@localhost:5432/gym_assistant?sslmode=disable

# Secret used to sign JWT access tokens. Required — generate a long random value.
# e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret

# Access-token lifetime in minutes.
ACCESS_TOKEN_TTL_MINUTES=60

# Comma-separated browser origins allowed by CORS. Use "*" to allow any origin
# (safe here because the API uses bearer tokens, not cookies). Defaults to the
# local web dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173
